# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-256-bit-key
APP_LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/truthlens.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/truthlens

# ── Search Provider ────────────────────────────────────────────────────────────
# Options: duckduckgo | serpapi | brave | bing
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT_SECONDS=10

# ── Optional Search API keys (leave blank if using duckduckgo) ─────────────────
SERPAPI_KEY=
BRAVE_SEARCH_KEY=
BING_SEARCH_KEY=

# ── Web Fetcher ────────────────────────────────────────────────────────────────
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_CONTENT_BYTES=5242880
# Allowed URL schemes (SSRF protection)
FETCH_ALLOWED_SCHEMES=https,http

# ── Cache ──────────────────────────────────────────────────────────────────────
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=86400

# ── File Upload ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_IMAGE_SIZE_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ── ChromaDB (optional semantic retrieval layer) ───────────────────────────────
CHROMA_ENABLED=false
CHROMA_PERSIST_DIR=./data/chroma

# ── OCR ────────────────────────────────────────────────────────────────────────
# Path to Tesseract binary (Windows example)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
